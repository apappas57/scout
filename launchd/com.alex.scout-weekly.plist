<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alex.scout-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Alex/dev/career/scout/scripts/run_scout.sh</string>
    </array>

    <!-- Sunday 20:00 local time. The Mac runs on AEST, so this is 20:00 AEST.
         Weekday 0 is Sunday in launchd. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/Alex/dev/career/scout</string>

    <key>StandardOutPath</key>
    <string>/Users/Alex/dev/career/scout/logs/scout-weekly.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Alex/dev/career/scout/logs/scout-weekly.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
